{
  "name": "hoard-frontend",
  "version": "1.44.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\"",
    "parity": "cd .. && python3 -m frontend.parity.compare_screens",
    "parity:tests": "cd .. && PYTEST_DISABLE_PLUGIN_AUTOLOAD=1 python3 -m pytest frontend/parity/tests -q -p no:cacheprovider",
    "parity:references": "cd .. && python3 -m frontend.parity.render_design_references",
    "lint": "eslint \"src/**/*.ts\" --max-warnings 0"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "lit": "^3.3.3",
    "marked": "^18.0.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "eslint": "^10.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.8.3",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.3.0",
    "vitest": "^5.0.5"
  }
}
