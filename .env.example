MOONRAKER_URL=http://moonraker.local
MOONRAKER_WS=ws://moonraker.local/websocket
HA_URL=http://homeassistant.local:8123
HA_TOKEN=eyJ0eXAiOiJKV1QiLC...
# Your Home Assistant entities (these are the defaults; map them to the names of your setup)
HA_POWER_SENSOR=sensor.3d_printer_power
HA_PRICE_SENSOR=sensor.electricity_price_all_in
HA_POWER_SWITCH=switch.3d_printer
# Energy sensors in kWh, comma separated, oldest first (keep the old ones of a plug you replaced)
HA_ENERGY_SENSORS=sensor.3d_printer_energy
# More switches to control from the dashboard, as Label=entity pairs separated by commas (any switch, light or
# input_boolean). The printer's own switch is HA_POWER_SWITCH above.
HA_SWITCHES=Power strip=switch.main_power_strip,Raspberry Pi=switch.pi_outlet,Filament dryer=switch.dryer_outlet
INFLUXDB_URL=http://influxdb.local:8086
INFLUXDB_TOKEN=...
INFLUXDB_ORG=my-org
INFLUXDB_BUCKET=home
DATABASE_PATH=/data/hoard.db

# MCP (optional): lets Claude use Hoard at /mcp. Make an entry per client with `uv run python -m app.mcp.new_token NAME SCOPE`
# (scope: read, control or admin); entries are name:scope:hash, separated by commas. Remove an entry to revoke it.
MCP_CLIENTS=

# Web push (optional). Generate a VAPID key pair; the subject is a mailto: address you own.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Redis caches the lists (default for docker compose: redis://redis:6379)
REDIS_URL=redis://localhost:6379
